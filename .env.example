# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection URI)
# In Supabase project settings -> Database -> Connection string -> URI (Pooled or Direct)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/product_management

# Authentication / Security
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# CORS Configuration (comma-separated or single domain)
CORS_ORIGIN=*
